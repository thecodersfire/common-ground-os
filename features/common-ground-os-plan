#!/usr/bin/env bash
set -euo pipefail
mkdir -p "$HOME/Documents/common-ground-os-session-plans"
file="$HOME/Documents/common-ground-os-session-plans/plan-$(date +%Y%m%d-%H%M%S).md"
{
 printf '# common-ground-os session plan\n\n'
 printf 'Created: %s\n\n' "$(date -Is)"
 printf 'Purpose: community coordination\n\n## Prompts\n'
 printf '%s\n' '- What routine or activity do you want to focus on?' '- What is a realistic small step?' '- What would make the session comfortable and private?'
 printf '\n## Notes\n'
} > "$file"
nano "$file"
printf 'Saved locally: %s\n' "$file"
